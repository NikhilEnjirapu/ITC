@model IReadOnlyList<ITC.TrainingPortal.Web.Services.ComplianceRow>
<div class="row mb-3"><div class="col"><strong>@Model.Count</strong> assignments</div><div class="col"><strong>@Model.Count(x=>x.Status=="Completed")</strong> completed</div><div class="col"><strong>@Model.Count(x=>x.Status=="Overdue")</strong> overdue</div></div>
<div class="table-responsive"><table class="table"><thead><tr><th>Employee</th><th>Department</th><th>Program</th><th>Videos</th><th>Exam</th><th>Best score</th><th>Status</th><th>Due date (IST)</th></tr></thead><tbody>
@foreach(var row in Model){<tr><td>@if(ViewContext.RouteData.Values["action"]?.ToString() != "Mine" && row.EmployeeRecordId > 0){<a asp-controller="Employee" asp-action="Details" asp-route-id="@row.EmployeeRecordId">@row.EmployeeId - @row.Employee</a>}else{<span>@row.EmployeeId - @row.Employee</span>}</td><td>@row.Department</td><td>@if(ViewContext.RouteData.Values["action"]?.ToString() != "Mine" && row.ProgramId > 0){<a asp-controller="TrainingProgram" asp-action="Details" asp-route-id="@row.ProgramId">@row.Program</a>}else{<span>@row.Program</span>}</td><td>@row.CompletedVideos / @row.TotalVideos</td><td>@row.Exam</td><td>@(row.Score.HasValue ? row.Score+"%" : "Not attempted")</td><td>@row.Status</td><td>@(row.DueDate.HasValue ? PortalTime.ToLocal(row.DueDate.Value).ToString("dd MMM yyyy") : "")</td></tr>}
</tbody></table></div>@if(Model.Count==0){<p>No matching assignments.</p>}

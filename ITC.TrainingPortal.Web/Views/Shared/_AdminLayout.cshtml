<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · ITC Training Portal</title><link rel="icon" href="~/favicon.ico" sizes="any" asp-append-version="true"/><link rel="apple-touch-icon" href="~/images/apple-touch-icon.png" asp-append-version="true"/><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/portal-ui.css" asp-append-version="true"/></head>
<body class="portal-ui admin-ui"><a class="skip-link" href="#main-content">Skip to main content</a><div class="app-shell"><partial name="_AdminSidebar"/><div class="app-workspace"><partial name="_Topbar"/><main id="main-content" class="app-content" tabindex="-1">@if(TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }<nav aria-label="Breadcrumb" class="mb-3"><a asp-controller="Home" asp-action="Index">Dashboard</a> / <span>@ViewData["Title"]</span></nav>@if(TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }@RenderBody()</main><footer class="app-footer">&copy; @DateTime.UtcNow.Year ITC · Employee Training Portal</footer></div></div><div class="sidebar-backdrop" data-sidebar-close></div><script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>

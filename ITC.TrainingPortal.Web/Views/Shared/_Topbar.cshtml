@{var pageTitle=ViewData["Title"]?.ToString()??"Dashboard";}
<header class="app-topbar"><button class="sidebar-toggle" type="button" data-sidebar-toggle aria-controls="appSidebar" aria-expanded="false" aria-label="Open navigation">☰</button><div class="topbar-title"><span>ITC Training Portal</span><strong>@pageTitle</strong></div><div class="topbar-user">@if(User.Identity?.IsAuthenticated==true){<div class="user-copy"><strong>@(User.Identity.Name??"Corporate user")</strong><span>Authenticated account</span></div><span class="user-avatar">@((User.Identity.Name??"U")[0].ToString().ToUpperInvariant())</span><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-secondary">Logout</button></form>}else{<span class="status-dot"></span><span class="text-muted small">Authentication pending</span>}</div></header>

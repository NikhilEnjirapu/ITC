@model IReadOnlyList<ITC.TrainingPortal.Domain.Entities.AuditLog>
@{ViewData["Title"]="Audit history";int page=ViewBag.Page;}
<h1>Audit history</h1><section class="content-card p-4"><form method="get" class="d-flex flex-wrap gap-2 mb-3"><input name="employeeId" value="@ViewBag.EmployeeId" class="form-control" placeholder="Employee ID" aria-label="Employee ID"/><input name="actionFilter" value="@ViewBag.ActionFilter" class="form-control" placeholder="Action contains" aria-label="Action contains"/><label>From (UTC)<input type="date" name="from" value="@ViewBag.From" class="form-control"/></label><label>To (UTC)<input type="date" name="to" value="@ViewBag.To" class="form-control"/></label><button class="btn btn-primary">Filter</button><a asp-action="Index" class="btn btn-outline-secondary">Clear filters</a></form><div class="table-responsive"><table class="table"><thead><tr><th>UTC time</th><th>Employee</th><th>User</th><th>Action</th><th>Details</th></tr></thead><tbody>@foreach(var row in Model){<tr><td>@row.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@row.EmployeeId</td><td>@row.UserId</td><td>@row.Action.Replace(".", " - ")</td><td><details><summary>View details</summary><pre style="white-space:pre-wrap">@row.Details</pre><p>IP: @row.IpAddress</p></details></td></tr>}@if(Model.Count == 0){<tr><td colspan="5">No audit events match these filters.</td></tr>}</tbody></table></div>@if(page>1){<a asp-route-page="@(page-1)" asp-route-employeeId="@ViewBag.EmployeeId" asp-route-actionFilter="@ViewBag.ActionFilter" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To">Previous</a>} <span>Page @(page)</span> @if(ViewBag.HasNext){<a asp-route-page="@(page+1)" asp-route-employeeId="@ViewBag.EmployeeId" asp-route-actionFilter="@ViewBag.ActionFilter" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To">Next</a>}</section>
@model ITC.TrainingPortal.Application.DTOs.DepartmentDto
@{
    ViewData["Title"] = "Create Department";
}
<h2 class="fw-bold mb-4">Create Department</h2>

<div class="row">
    <div class="col-md-6">
        <div class="glass-panel p-4">
            <form asp-action="Create"><input type="hidden" name="returnToEmployee" value="@(ViewBag.ReturnToEmployee == true ? "true" : "false")"/>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div>
                    <button type="submit" class="btn btn-primary me-2">Save</button>
                    <a asp-action="Index" class="btn btn-outline-light">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model ITC.TrainingPortal.Application.DTOs.DepartmentDto
@{ViewData["Title"]="Department details";}<div class="page-header"><div><div class="eyebrow">Department management</div><h1>@Model.Name</h1><p>Department information.</p></div><div class="page-actions"><a asp-controller="Employee" asp-action="Index" asp-route-departmentId="@Model.Id" class="btn btn-outline-primary">View employees</a><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit department</a><a asp-action="Index" class="btn btn-outline-light">Back to list</a></div></div><section class="content-card"><dl class="detail-grid"><div class="detail-item"><dt>Department name</dt><dd>@Model.Name</dd></div><div class="detail-item"><dt>Reference</dt><dd>#@Model.Id</dd></div><div class="detail-item" style="grid-column:1/-1"><dt>Description</dt><dd>@(Model.Description??"No description provided")</dd></div></dl></section>

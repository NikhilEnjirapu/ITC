@model IEnumerable<ITC.TrainingPortal.Application.DTOs.DepartmentDto>
@{ViewData["Title"]="Departments";}<div class="page-header"><div><div class="eyebrow">Organization</div><h1>Departments</h1><p>Maintain the organizational groups used by employee records.</p></div><a asp-action="Create" class="btn btn-primary">Add department</a></div><section class="content-card directory-card"><div class="list-toolbar"><div class="search-control"><input class="form-control" type="search" placeholder="Search departments" data-table-search="#departmentTable" aria-label="Search departments"/></div></div>@if(Model.Any()){<div class="table-responsive"><table id="departmentTable" class="table table-hover"><thead><tr><th>Name</th><th>Description</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach(var x in Model){<tr data-search-row><td><strong>@x.Name</strong></td><td>@x.Description</td><td class="text-end actions-cell"><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-outline-primary">View</a> <a asp-action="Edit" asp-route-id="@x.Id" class="btn btn-sm btn-outline-light">Edit</a> <a asp-action="Delete" asp-route-id="@x.Id" class="btn btn-sm btn-outline-danger">Delete</a></td></tr>}</tbody></table></div>}else{<div class="empty-state"><div class="empty-state-icon">◇</div><h3>No departments</h3><p>Create a department before adding employees.</p><a asp-action="Create" class="btn btn-primary">Add department</a></div>}</section>

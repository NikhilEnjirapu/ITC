@model ITC.TrainingPortal.Web.Models.MyTrainingViewModel
@using ITC.TrainingPortal.Application.Identity
@{ ViewData["Title"] = "My Training"; }
<div class="page-header"><div><div class="eyebrow">My learning</div><h1>Assigned training</h1><p>@(Model.EmployeeName is null ? "Your training programs, progress, and available exams." : $"Training assigned to {Model.EmployeeName}.")</p></div></div>
@if(TempData["TrainingMessage"] is string message){<div class="alert alert-warning">@message</div>}
@if (Model.IdentityStatus != EmployeeIdentityResolutionStatus.Resolved)
{
    <section class="content-card prepared-state"><div class="prepared-icon">▤</div><h1>Employee identity is not available</h1><p>The catalog uses authenticated employee matching and real assignment records. Entra ID and the employee claim mapping must be configured by the client before personal training can be displayed.</p></section>
}
else if (!Model.Assignments.Any())
{
    <section class="content-card empty-state"><div class="empty-state-icon">▤</div><h3>No assigned training</h3><p>No training programs are currently assigned to your employee record.</p></section>
}
else
{
    <div class="training-catalog">
    @foreach (var item in Model.Assignments)
    {
        <article class="content-card training-card"><div class="content-card-body">
            <div class="eyebrow">Assigned @item.AssignedAt.ToString("dd MMM yyyy")</div><h2>@item.TrainingProgramTitle</h2><p>@(item.Description ?? "No description provided")</p>
            <div class="d-flex justify-content-between small mb-2"><span>@item.CompletedVideoCount / @item.VideoCount videos completed</span><strong>@item.ProgressPercentage%</strong></div>
            <div class="progress mb-3" role="progressbar" aria-label="Training progress" aria-valuenow="@item.ProgressPercentage" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:@item.ProgressPercentage%"></div></div>
            <div class="d-flex flex-wrap gap-2 mb-3"><span class="badge-status @(item.TrainingStatus == "Complete" ? "status-complete" : item.TrainingStatus == "In Progress" ? "status-progress" : "status-pending")">@item.TrainingStatus</span><span class="badge-status status-pending">@item.ExamStatus</span>@if(item.DueDate.HasValue){<span class="text-muted small align-self-center">Due @item.DueDate.Value.ToString("dd MMM yyyy")</span>}</div>
            @if(Model.ExamResults.TryGetValue(item.TrainingProgramId, out var result)) { <p>Exam completed: @result.ScorePercentage% — @(result.IsPassed ? "Passed" : "Failed")</p><a asp-controller="Quiz" asp-action="Result" asp-route-id="@result.Id" class="btn btn-primary">View result</a> }
            @if(item.CurrentVideoTitle is not null){<p class="small"><strong>Next:</strong> @item.CurrentVideoTitle</p>}
            <a asp-controller="Training" asp-action="Content" asp-route-id="@item.TrainingProgramId" class="btn btn-primary">@(item.CompletedVideoCount > 0 ? "Continue training" : "Open training")</a>
        </div></article>
    }
    </div>
}

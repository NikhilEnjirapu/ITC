@model ITC.TrainingPortal.Application.DTOs.ExamAttemptDto
@{ViewData["Title"]=Model.QuizTitle;}<div class="page-header"><div><div class="eyebrow">Exam in progress</div><h1>@Model.QuizTitle</h1><p>@Model.TrainingProgramTitle</p></div></div>
<section class="content-card learning-panel"><form asp-action="Submit" method="post"><input type="hidden" name="attemptId" value="@Model.AttemptId"/>
@foreach(var q in Model.Questions){<fieldset class="mb-4"><legend class="h5">@q.SequenceOrder. @q.QuestionText</legend>@foreach(var option in q.Options){<div class="form-check mb-2"><input class="form-check-input" type="radio" name="answers[@q.Id]" id="q@(q.Id)@option.Key" value="@option.Key" required/><label class="form-check-label" for="q@(q.Id)@option.Key">@option.Key. @option.Value</label></div>}</fieldset>}
<button class="btn btn-primary" type="submit">Submit exam</button></form></section>

<script>localStorage.setItem("training-exam-started", Date.now().toString());</script>

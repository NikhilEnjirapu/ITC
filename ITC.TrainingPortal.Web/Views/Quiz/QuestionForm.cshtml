@model ITC.TrainingPortal.Application.DTOs.QuizQuestionDto
@{ViewData["Title"]=Model.Id==0?"Add question":"Edit question";}<div class="page-header"><div><h1>@ViewData["Title"]</h1></div></div><section class="content-card admin-form-card"><form method="post"><div asp-validation-summary="All" class="text-danger"></div><input type="hidden" asp-for="Id"/><input type="hidden" asp-for="QuizId"/>
<div class="mb-3"><label asp-for="IsTypedAnswer" class="form-label">Answer format</label><select asp-for="IsTypedAnswer" class="form-select"><option value="false">Multiple choice</option><option value="true">Typed answer (manual review)</option></select><div class="form-text">Each question has equal weight. Administrators mark typed answers correct or incorrect after submission.</div></div>
<div class="mb-3"><label asp-for="QuestionText" class="form-label">Question</label><textarea asp-for="QuestionText" class="form-control"></textarea></div>
<div class="row" data-choice-fields><div class="col-md-6 mb-3"><label asp-for="OptionA" class="form-label">Option A</label><input asp-for="OptionA" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="OptionB" class="form-label">Option B</label><input asp-for="OptionB" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="OptionC" class="form-label">Option C</label><input asp-for="OptionC" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="OptionD" class="form-label">Option D</label><input asp-for="OptionD" class="form-control"/></div></div>
<div class="row"><div class="col-md-6 mb-3" data-choice-fields><label asp-for="CorrectOption" class="form-label">Correct option</label><select asp-for="CorrectOption" class="form-select"><option value="">Select</option><option>A</option><option>B</option><option>C</option><option>D</option></select></div><div class="col-md-6 mb-3"><label asp-for="SequenceOrder" class="form-label">Order</label><input asp-for="SequenceOrder" class="form-control"/></div></div><button class="btn btn-primary">Save question</button> @if(Model.Id == 0){<button name="addAnother" value="true" class="btn btn-outline-primary">Save and add another</button>} <a asp-action="Details" asp-route-id="@Model.QuizId" class="btn btn-outline-secondary">Cancel</a></form></section>

<script src="~/js/question-format.js" asp-append-version="true"></script>

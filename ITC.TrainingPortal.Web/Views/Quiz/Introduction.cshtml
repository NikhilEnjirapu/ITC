@model ITC.TrainingPortal.Application.DTOs.ExamAccessDto
@{ ViewData["Title"] = Model.QuizTitle; }
<div class="page-header"><div><div class="eyebrow">@Model.TrainingProgramTitle</div><h1>@Model.QuizTitle</h1></div></div>
@if (TempData["QuizMessage"] is string message) { <div class="alert alert-warning">@message</div> }
<section class="content-card learning-panel"><h2 class="h4">Before you begin</h2>
<p>This exam contains @Model.QuestionCount questions. Questions are shuffled for every attempt. Answer every question before submitting. Training videos are unavailable while an attempt is active.</p>
<p><strong>Attempts:</strong> @Model.AttemptCount of @ITC.TrainingPortal.Application.DTOs.ExamAccessDto.MaximumAttempts used · @Model.RemainingAttempts remaining</p>
@if (Model.BestResult is { } best) { <p><strong>Best score:</strong> @best.Outcome</p> }
@if (!Model.IsUnlocked) { <div class="alert alert-warning">@Model.UnlockMessage</div> }
else if (!Model.IsActive) { <div class="alert alert-warning">This exam is currently inactive.</div> }
else if (!Model.ActiveAttemptId.HasValue && !Model.HasAttemptsRemaining) { <div class="alert alert-info">You have used all available attempts.</div> }
else { <form asp-action="Start" asp-route-id="@Model.QuizId" method="post"><button class="btn btn-primary">@(Model.ActiveAttemptId.HasValue ? "Resume exam" : Model.AttemptCount > 0 ? "Start next attempt" : "Start Exam")</button></form> }
</section>

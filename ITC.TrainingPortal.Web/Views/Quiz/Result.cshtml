@model ITC.TrainingPortal.Application.DTOs.QuizResultDto
@{ViewData["Title"]="Exam result";}<div class="page-header"><div><div class="eyebrow">@Model.TrainingProgramTitle</div><h1>@Model.QuizTitle</h1></div></div>
<section class="content-card learning-panel text-center"><h2>@Model.Outcome</h2>@if(Model.RequiresReview){<p>Your answers have been submitted. Your score will appear after an administrator reviews them.</p>}<p>Attempt started @Model.AttemptDate.ToLocalTime().ToString("g")<br/>Completed @Model.CompletedAt?.ToLocalTime().ToString("g")</p><p>Completion status: Submitted</p><a asp-action="Mine" class="btn btn-primary">Back to my exams</a></section>

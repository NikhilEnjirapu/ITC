@model ITC.TrainingPortal.Application.DTOs.QuizResultDto
@{ViewData["Title"]="Exam result";}<div class="page-header"><div><div class="eyebrow">@Model.TrainingProgramTitle</div><h1>@Model.QuizTitle</h1></div></div>
<section class="content-card learning-panel text-center"><div class="display-4 mb-2">@Model.ScorePercentage%</div><h2 class="@(Model.IsPassed?"text-success":"text-danger")">@(Model.IsPassed?"Passed":"Not passed")</h2><p>Attempt started @Model.AttemptDate.ToLocalTime().ToString("g")<br/>Completed @Model.CompletedAt?.ToLocalTime().ToString("g")</p><p>Completion status: Submitted</p><a asp-action="Mine" class="btn btn-primary">Back to my exams</a></section>

@model ITC.TrainingPortal.Web.Controllers.QuizAdminDetailsViewModel
@{ViewData["Title"]=Model.Quiz.Title;}
<section class="content-card p-3 mb-3"><strong>Exam Unlock:</strong> @Model.Quiz.ExamUnlockDescription
    <a asp-controller="TrainingProgram" asp-action="Availability" asp-route-id="@Model.Quiz.TrainingProgramId" class="ms-2" asp-fragment="exam-unlock">Configure Exam Unlock</a>
<a asp-controller="TrainingProgram" asp-action="Details" asp-route-id="@Model.Quiz.TrainingProgramId" class="btn btn-outline-primary ms-2">Back to Program</a></section>
<div class="page-header"><div><div class="eyebrow">@Model.Quiz.TrainingProgramTitle</div><h1>@Model.Quiz.Title</h1><p>Passing score: @Model.Quiz.PassingScorePercentage% · @(Model.Quiz.IsActive?"Active":"Inactive")</p></div><div><a asp-action="Edit" asp-route-id="@Model.Quiz.Id" class="btn btn-outline-primary">Edit</a> <a asp-action="Delete" asp-route-id="@Model.Quiz.Id" class="btn btn-outline-danger">Delete</a></div></div>
<section class="content-card admin-questions"><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 mb-0">Questions</h2><a asp-action="AddQuestion" asp-route-quizId="@Model.Quiz.Id" class="btn btn-primary">Add question</a></div>
@foreach(var q in Model.Questions){<div class="border rounded p-3 mb-3"><div class="d-flex justify-content-between"><strong>@q.SequenceOrder. @q.QuestionText</strong><div><a asp-action="EditQuestion" asp-route-id="@q.Id">Edit</a><form onsubmit="return confirm('Delete this question?')" asp-action="DeleteQuestion" class="d-inline ms-2"><input type="hidden" name="id" value="@q.Id"/><input type="hidden" name="quizId" value="@q.QuizId"/><button class="btn btn-link text-danger p-0">Delete</button></form></div></div>@if(q.IsTypedAnswer){<p class="text-muted mt-2">Typed answer ? Manual review</p>}else{<div class="text-muted mt-2">A. @q.OptionA · B. @q.OptionB · C. @q.OptionC · D. @q.OptionD</div><small>Correct option: @q.CorrectOption</small>}</div>}
@if(Model.Questions.Count==0){<p class="text-muted">No questions added.</p>}</section>

@if(TempData["QuizMessage"] is string message){<div class="alert alert-warning">@message</div>}

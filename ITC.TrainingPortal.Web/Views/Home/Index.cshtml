@model ITC.TrainingPortal.Web.Models.DashboardViewModel
@{ViewData["Title"]="Dashboard";}
<div class="page-header"><div><div class="eyebrow">Overview</div><h1>Training administration</h1><p>Manage employee learning and monitor the available training data.</p></div><partial name="_DashboardActions" model="Model"/></div>
@if(!Model.IsDataAvailable){<div class="alert alert-warning"><strong>Dashboard data is unavailable.</strong> The application UI is running, but the database schema or connection must be brought up to date before live metrics can load.</div>}
<div class="metric-grid dashboard-metrics"><div class="metric-card"><svg class="metric-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3m2-15a3 3 0 0 1 0 6m2 3a5 5 0 0 1 2 4v2"/></svg><span>Total employees</span><strong>@(Model.IsDataAvailable?Model.TotalEmployees:"—")</strong><small>Registered employees</small></div><div class="metric-card"><svg class="metric-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5C9 3 5 3 2 4v15c3-1 7-1 10 1 3-2 7-2 10-1V4c-3-1-7-1-10 1v15"/></svg><span>Training programs</span><strong>@(Model.IsDataAvailable?Model.TotalPrograms:"—")</strong><small>Data-driven programs</small></div><div class="metric-card"><svg class="metric-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="12" height="14" rx="2"/><path d="m15 9 6-3v12l-6-3Z"/></svg><span>Training videos</span><strong>@(Model.IsDataAvailable?Model.TotalVideos:"—")</strong><small>Across all programs</small></div><div class="metric-card"><svg class="metric-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 2h6v4H9Zm-1 11 3 3 5-6"/></svg><span>Assigned training</span><strong>@(Model.IsDataAvailable?Model.TotalAssignments:"—")</strong><small>Employee assignments</small></div><div class="metric-card"><svg class="metric-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4 4L20 5M20 12v8H4V4h9"/></svg><span>Completed assignments</span><strong>@(Model.IsDataAvailable ? Model.CompletedAssignments.ToString() : "Unavailable")</strong></div><div class="metric-card"><svg class="metric-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v6l4 2"/></svg><span>Overdue assignments</span><strong>@(Model.IsDataAvailable ? Model.OverdueAssignments.ToString() : "Unavailable")</strong></div></div><div class="section-grid"><section class="content-card"><div class="content-card-header"><div><strong>Recent assignments</strong><div class="text-muted small">Latest available assignment records</div></div><a asp-controller="TrainingAssignment" asp-action="Index" class="btn btn-sm btn-outline-primary">View all</a></div>@if(Model.RecentAssignments.Any()){<div class="table-responsive"><table class="table"><thead><tr><th>Employee</th><th>Program</th><th>Assigned</th><th>Due</th></tr></thead><tbody>@foreach(var x in Model.RecentAssignments){<tr><td>@x.EmployeeName</td><td>@x.TrainingProgramTitle</td><td>@x.AssignedAt.ToString("dd MMM yyyy")</td><td>@(x.DueDate?.ToString("dd MMM yyyy")??"Not set")</td></tr>}</tbody></table></div>}else{<div class="empty-state"><div class="empty-state-icon">✓</div><h3>No assignments to display</h3><p>Start by creating a program, adding its videos and exam, then assigning employees.</p></div>}</section><aside class="content-card"><div class="content-card-header"><strong>Quick actions</strong></div><div class="content-card-body quick-actions"><a asp-controller="Employee" asp-action="Create">Add employee</a><a asp-controller="Department" asp-action="Create">Add department</a><a asp-controller="TrainingVideo" asp-action="Create">Add training video</a><a asp-controller="Quiz" asp-action="Index">Review exam readiness</a></div></aside></div>

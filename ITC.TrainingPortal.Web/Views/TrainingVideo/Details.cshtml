@model ITC.TrainingPortal.Application.DTOs.TrainingVideoDto
@{ViewData["Title"]="Training video details";}<div class="page-header"><div><div class="eyebrow">@Model.TrainingProgramTitle</div><h1>@Model.Title</h1><p>Video @Model.SequenceOrder in this training program.</p></div><div class="page-actions"><a asp-action="Player" asp-route-id="@Model.Id" class="btn btn-primary">Preview player</a><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit</a><a asp-controller="TrainingProgram" asp-action="Details" asp-route-id="@Model.TrainingProgramId" class="btn btn-outline-light">Back to program</a></div></div><section class="content-card"><dl class="detail-grid"><div class="detail-item"><dt>Training program</dt><dd>@Model.TrainingProgramTitle</dd></div><div class="detail-item"><dt>Sequence</dt><dd>@Model.SequenceOrder</dd></div><div class="detail-item"><dt>Repository filename</dt><dd>@Model.VideoUrl</dd></div><div class="detail-item"><dt>Description</dt><dd>@(Model.Description??"No description provided")</dd></div></dl></section>

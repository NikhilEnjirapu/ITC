@model IEnumerable<ITC.TrainingPortal.Application.DTOs.TrainingVideoDto>
@if (TempData["Success"] is string message) { <div class="alert alert-success" role="status">@message</div> }
@{ViewData["Title"]="Training Videos";}<div class="page-header"><div><div class="eyebrow">Program content</div><h1>Training videos</h1><p>Manage ordered video content across all training programs.</p></div><a asp-action="Create" class="btn btn-primary">Add video</a></div><section class="content-card directory-card"><div class="list-toolbar"><div class="search-control"><input class="form-control" type="search" placeholder="Search videos or programs" data-table-search="#videoTable" aria-label="Search videos"/></div></div>@if(Model.Any()){<div class="table-responsive"><table id="videoTable" class="table table-hover"><thead><tr><th>Program</th><th>Order</th><th>Video title</th><th>Source</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach(var x in Model){<tr data-search-row><td>@x.TrainingProgramTitle</td><td><span class="badge-status status-progress">@x.SequenceOrder</span></td><td><strong>@x.Title</strong></td><td>@x.VideoUrl</td><td class="text-end actions-cell"><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-outline-primary">View</a> <a asp-action="Edit" asp-route-id="@x.Id" class="btn btn-sm btn-outline-light">Edit</a> <a asp-action="Delete" asp-route-id="@x.Id" class="btn btn-sm btn-outline-danger">Delete</a></td></tr>}</tbody></table></div>}else{<div class="empty-state"><div class="empty-state-icon">▶</div><h3>No training videos</h3><p>Add videos to any existing training program.</p><a asp-action="Create" class="btn btn-primary">Add video</a></div>}</section>

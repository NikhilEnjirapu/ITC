@model IReadOnlyList<ITC.TrainingPortal.Domain.Entities.EligibilityRule>
@{ViewData["Title"] = "Eligibility rules";}
<div class="page-header"><div><h1>Eligibility rules</h1><p>Additional exclusions apply immediately to both roles. T/S IDs and unverified, contractor, third-party, intern and temporary categories are always excluded.</p></div><a asp-action="Create" class="btn btn-primary">Add exclusion</a></div>
<section class="content-card directory-card p-4"><div class="table-responsive"><table class="table"><thead><tr><th>Rule</th><th>Value</th><th>Active</th><th>Actions</th></tr></thead><tbody>
@foreach(var rule in Model){<tr><td>@rule.RuleType</td><td>@rule.RuleValue</td><td>@rule.IsActive</td><td><a asp-action="Edit" asp-route-id="@rule.Id" class="btn btn-sm btn-outline-primary">Edit</a><form asp-action="Delete" method="post" class="d-inline"><input type="hidden" name="id" value="@rule.Id"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this additional exclusion?')">Delete</button></form></td></tr>}
</tbody></table></div>@if(Model.Count == 0){<p>No additional exclusions configured.</p>}</section>

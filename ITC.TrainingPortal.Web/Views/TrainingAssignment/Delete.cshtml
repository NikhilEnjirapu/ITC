@model ITC.TrainingPortal.Application.DTOs.TrainingAssignmentDto
@{ViewData["Title"]="Delete Assignment";}<h2 class="text-danger">Delete Assignment</h2><div class="glass-panel p-4"><p><strong>@Model.EmployeeName</strong></p><p>@Model.TrainingProgramTitle</p><p>Removing this assignment removes access to this program. An exam already in progress can still be resumed and submitted. Existing viewing progress and exam results are retained and will be reused if the same program is assigned again.</p><form asp-action="Delete"><input type="hidden" asp-for="Id"/><button class="btn btn-danger">Delete</button> <a asp-action="Index" class="btn btn-outline-light">Cancel</a></form></div>

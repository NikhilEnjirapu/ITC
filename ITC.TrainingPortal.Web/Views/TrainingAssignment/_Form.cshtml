@model ITC.TrainingPortal.Application.DTOs.TrainingAssignmentDto
<div asp-validation-summary="ModelOnly" class="text-danger"></div><input type="hidden" asp-for="Id"/><input type="hidden" asp-for="RowVersion"/>
<div class="mb-3"><label asp-for="TrainingProgramId" class="form-label"></label><select asp-for="TrainingProgramId" asp-items="ViewBag.Programs" class="form-control"><option value="">-- Select Program --</option></select><span asp-validation-for="TrainingProgramId" class="text-danger"></span></div>
@if(Model.Id == 0) { <div class="mb-3"><label for="employeeIds" class="form-label">Employees</label><select id="employeeIds" name="employeeIds" asp-items="ViewBag.Employees" multiple size="6" class="form-select" required aria-describedby="employee-selection-help"></select><p id="employee-selection-help" class="form-text">Select one or more employees. Use Ctrl or Command to select several.</p><span asp-validation-for="EmployeeId" class="text-danger"></span></div> } else { <div class="mb-3"><label asp-for="EmployeeId" class="form-label"></label><select asp-for="EmployeeId" asp-items="ViewBag.Employees" class="form-control"><option value="">-- Select Employee --</option></select><span asp-validation-for="EmployeeId" class="text-danger"></span></div> }

<div class="mb-3"><label asp-for="AssignedAt" class="form-label">Assigned date and time (UTC)</label><input asp-for="AssignedAt" type="datetime-local" class="form-control"/><span asp-validation-for="AssignedAt" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="DueDate" class="form-label">Due date and time (UTC, optional)</label><input asp-for="DueDate" type="datetime-local" class="form-control"/><span asp-validation-for="DueDate" class="text-danger"></span></div>

<partial name="_AssignmentReview"/>

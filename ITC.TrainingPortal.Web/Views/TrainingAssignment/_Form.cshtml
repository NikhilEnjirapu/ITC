@model ITC.TrainingPortal.Application.DTOs.TrainingAssignmentDto
<div asp-validation-summary="ModelOnly" class="text-danger"></div><input type="hidden" asp-for="Id"/><input type="hidden" asp-for="RowVersion"/>
<div class="mb-3"><label asp-for="TrainingProgramId" class="form-label"></label><select asp-for="TrainingProgramId" asp-items="ViewBag.Programs" class="form-control"><option value="">-- Select Program --</option></select><span asp-validation-for="TrainingProgramId" class="text-danger"></span></div>
@if(Model.Id == 0) { <partial name="_EmployeePicker" model="Model"/> } else { <div class="mb-3"><label asp-for="EmployeeId" class="form-label"></label><select asp-for="EmployeeId" asp-items="ViewBag.Employees" class="form-control"><option value="">-- Select Employee --</option></select><span asp-validation-for="EmployeeId" class="text-danger"></span></div> }

<p id="assignment-time-help" class="form-text">All dates and times are in India Standard Time (IST). Assigned on is prefilled with the current time; change it only if needed.</p>
<div class="mb-3"><label asp-for="AssignedAt" class="form-label">Assigned on</label><input asp-for="AssignedAt" type="datetime-local" step="60" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" aria-describedby="assignment-time-help"/><button type="button" id="assignment-now" class="btn btn-outline-secondary btn-sm mt-2">Use current time</button><span asp-validation-for="AssignedAt" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="DueDate" class="form-label">Due by (optional)</label><input asp-for="DueDate" type="datetime-local" step="60" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" aria-describedby="assignment-time-help"/><div class="form-text">Leave empty if there is no deadline.</div><span asp-validation-for="DueDate" class="text-danger"></span></div>

<partial name="_AssignmentReview"/>

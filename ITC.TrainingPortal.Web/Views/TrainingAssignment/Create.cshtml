@model ITC.TrainingPortal.Application.DTOs.TrainingAssignmentDto
@{ViewData["Title"]="Assign Training";}<h2>Assign Training</h2><div class="glass-panel p-4"><p>Choose a ready program, then eligible employees and a due date. Incomplete programs show the setup step still required.</p><p><a asp-controller="TrainingProgram" asp-action="Create">Create a new program</a> | <a asp-controller="TrainingProgram" asp-action="Index">Review program setup and exam availability</a></p>@if(TempData["BatchError"] is string error){<div class="alert alert-warning">@error</div>}<form asp-action="Preview" method="post" enctype="multipart/form-data"><partial name="_Form" model="Model"/><button class="btn btn-primary">Preview assignment</button> <a asp-action="Index" class="btn btn-outline-light">Cancel</a></form></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script src="~/js/employee-picker.js" asp-append-version="true"></script><script src="~/js/assignment-dates.js" asp-append-version="true"></script>}

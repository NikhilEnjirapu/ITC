@model IReadOnlyList<ITC.TrainingPortal.Web.Services.ComplianceRow>
@{ViewData["Title"]="Progress & Reports"; ITC.TrainingPortal.Web.Services.ReportFilter filter=ViewBag.Filter;}
<h1>Progress &amp; Reports</h1><section class="content-card p-4"><form method="get"><div class="row g-3"><div class="col"><label>Employee</label><select name="EmployeeId" asp-items="ViewBag.Employees" class="form-select"><option value="">All employees</option></select></div><div class="col"><label>Department</label><select name="DepartmentId" asp-items="ViewBag.Departments" class="form-select"><option value="">All departments</option></select></div><div class="col"><label>Program</label><select name="TrainingProgramId" asp-items="ViewBag.Programs" class="form-select"><option value="">All programs</option></select></div><div class="col"><label>Status</label><select name="Status" class="form-select"><option value="">All statuses</option>@foreach(var status in new[]{"Not started","In progress","Completed","Overdue"}){<option selected="@(filter.Status==status)" value="@status">@status</option>}</select></div></div><div class="my-3"><button class="btn btn-primary">Apply filters</button> <a asp-action="Index" class="btn btn-outline-secondary">Clear filters</a> <a asp-action="Excel" asp-route-EmployeeId="@filter.EmployeeId" asp-route-DepartmentId="@filter.DepartmentId" asp-route-TrainingProgramId="@filter.TrainingProgramId" asp-route-Status="@filter.Status" download class="btn btn-outline-primary">Export Excel</a> <a asp-action="Pdf" asp-route-EmployeeId="@filter.EmployeeId" asp-route-DepartmentId="@filter.DepartmentId" asp-route-TrainingProgramId="@filter.TrainingProgramId" asp-route-Status="@filter.Status" download class="btn btn-outline-primary">Export PDF</a></div></form><p class="text-muted small">Exports include the results currently displayed. Apply any changed filters before downloading.</p><partial name="_ComplianceTable" model="Model"/></section>
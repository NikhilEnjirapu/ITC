@{ViewData["Title"]="Profile";}<div class="page-header"><div><div class="eyebrow">Account</div><h1>Profile</h1><p>Corporate identity and employee information.</p></div></div><section class="content-card"><div class="content-card-body">@if(User.Identity?.IsAuthenticated==true){<dl class="detail-grid"><div class="detail-item"><dt>Display name</dt><dd>@(User.Identity.Name??"Not supplied")</dd></div><div class="detail-item"><dt>Account status</dt><dd><span class="badge-status status-complete">Authenticated</span></dd></div></dl>}else{<div class="empty-state"><div class="empty-state-icon">○</div><h3>No authenticated profile</h3><p>Corporate identity details will be available after Entra ID is configured.</p><a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">Corporate sign-in</a></div>}</div></section>

@model ITC.TrainingPortal.Application.DTOs.TrainingProgramDto
@{ ViewData["Title"] = "Exam availability"; }
<div class="page-header"><div><h1>When can employees take this exam?</h1><p>@Model.Title</p></div></div>
<section class="content-card p-4">
<p>Choose when the exam becomes available. Employees start it themselves; it does not start automatically.</p>
<form method="post">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <input type="hidden" asp-for="Id"/><input type="hidden" asp-for="RowVersion"/>
    <label asp-for="ExamUnlockCondition" class="form-label">Exam availability</label>
    <select asp-for="ExamUnlockCondition" class="form-select mb-3"><option value="0">After all videos are completed</option><option value="1">After a specific video is completed</option></select>
    <div id="unlockVideoField" class="mb-3"><label asp-for="ExamUnlockVideoId" class="form-label">Choose a video</label><select asp-for="ExamUnlockVideoId" asp-items="ViewBag.UnlockVideos" class="form-select"><option value="">Select a video</option></select></div>
    <button class="btn btn-primary">Save and review program</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Back to program</a>
</form>
</section>
@section Scripts { <script src="~/js/exam-unlock-config.js" asp-append-version="true"></script> }

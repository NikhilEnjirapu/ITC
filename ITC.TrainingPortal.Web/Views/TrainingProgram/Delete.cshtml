@model ITC.TrainingPortal.Application.DTOs.TrainingProgramDto
@{ ViewData["Title"] = "Delete Training Program"; }
<h2 class="text-danger">Delete Training Program</h2>
<div class="glass-panel p-4">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <h4>@Model.Title</h4>
    <p>@Model.Description</p>
    <div class="alert alert-warning">
        <strong>This archives the training program and preserves its reports.</strong>
        <p>It will be removed from the program list and cannot be assigned to new employees.</p>
        <p class="mb-0">Existing assignments, viewing progress, exam questions, attempts, and results are retained. Employees already assigned can continue their training.</p>
    </div>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Archive training program</button>
        <a asp-action="Index" class="btn btn-outline-light">Cancel</a>
    </form>
</div>

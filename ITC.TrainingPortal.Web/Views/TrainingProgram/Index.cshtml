@inject ITC.TrainingPortal.Web.Services.AdminWorkflowService Workflow
@{ var setup = (await Workflow.ProgramsAsync()).ToDictionary(x => x.Id); }
@model IEnumerable<ITC.TrainingPortal.Application.DTOs.TrainingProgramDto>
@{ViewData["Title"]="Training Programs";}<div class="page-header"><div><div class="eyebrow">Learning catalog</div><h1>Training programs</h1><p>Create and maintain any number of reusable training programs.</p></div><a asp-action="Create" class="btn btn-primary">Create program</a></div><section class="content-card directory-card"><div class="list-toolbar"><div class="search-control"><input class="form-control" type="search" placeholder="Search programs" data-table-search="#programTable" aria-label="Search programs"/></div></div>@if(Model.Any()){<div class="table-responsive"><table id="programTable" class="table table-hover"><thead><tr><th>Program</th><th>Description</th><th>Content</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach(var x in Model){<tr data-search-row><td><strong>@x.Title</strong></td><td>@x.Description</td><td><span class="badge-status status-progress">@(setup[x.Id].Missing ?? "Ready to assign")</span></td><td class="text-end actions-cell"><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-outline-primary">Continue / View</a> <a asp-action="Edit" asp-route-id="@x.Id" class="btn btn-sm btn-outline-light">Edit</a> <a asp-action="Delete" asp-route-id="@x.Id" class="btn btn-sm btn-outline-danger">Delete</a></td></tr>}</tbody></table></div>}else{<div class="empty-state"><div class="empty-state-icon">▤</div><h3>No training programs</h3><p>No training programs have been created yet.</p><a asp-action="Create" class="btn btn-primary">Create training program</a></div>}</section>

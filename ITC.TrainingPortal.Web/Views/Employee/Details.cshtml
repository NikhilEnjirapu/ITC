@model ITC.TrainingPortal.Application.DTOs.EmployeeDto
@{ViewData["Title"]="Employee details";}<div class="page-header"><div><div class="eyebrow">Employee management</div><h1>@Model.FirstName @Model.LastName</h1><p>Employee profile and organizational assignment.</p></div><div class="page-actions"><a asp-controller="TrainingAssignment" asp-action="Create" asp-route-employeeId="@Model.Id" class="btn btn-primary">Assign training</a><a asp-controller="Report" asp-action="Index" asp-route-EmployeeId="@Model.Id" class="btn btn-outline-primary">View progress</a><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit employee</a><a asp-action="Index" class="btn btn-outline-light">Back to list</a></div></div><section class="content-card"><dl class="detail-grid"><div class="detail-item"><dt>Employee ID</dt><dd>@Model.EmployeeId</dd></div><div class="detail-item"><dt>Department</dt><dd>@(Model.DepartmentName??"Not available")</dd></div><div class="detail-item"><dt>Full name</dt><dd>@Model.FirstName @Model.LastName</dd></div><div class="detail-item"><dt>Email</dt><dd><a href="mailto:@Model.Email">@Model.Email</a></dd></div></dl></section>

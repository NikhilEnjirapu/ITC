@model IEnumerable<ITC.TrainingPortal.Application.DTOs.EmployeeDto>
@{ViewData["Title"]="Employees";}<div class="page-header"><div><div class="eyebrow">People</div><h1>Employees</h1><p>Manage employee records and department membership.</p></div><a asp-action="Create" class="btn btn-primary">Add employee</a></div><section class="content-card directory-card"><div class="list-toolbar"><div class="search-control"><input class="form-control" type="search" placeholder="Search employees" aria-label="Search employees" data-table-search="#employeeTable"/></div></div>@if(Model.Any()){<div class="table-responsive"><table id="employeeTable" class="table table-hover"><thead><tr><th>Employee ID</th><th>Name</th><th>Email</th><th>Department</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach(var x in Model){<tr data-search-row><td><strong>@x.EmployeeId</strong></td><td>@x.FirstName @x.LastName</td><td>@x.Email</td><td>@x.DepartmentName</td><td><span class="badge-status status-complete">Active record</span></td><td class="text-end actions-cell"><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-outline-primary">View</a> <a asp-action="Edit" asp-route-id="@x.Id" class="btn btn-sm btn-outline-light">Edit</a> <a asp-action="Delete" asp-route-id="@x.Id" class="btn btn-sm btn-outline-danger">Delete</a></td></tr>}</tbody></table></div>}else{<div class="empty-state"><div class="empty-state-icon">◎</div><h3>No employees</h3><p>Add an employee to begin assigning training.</p><a asp-action="Create" class="btn btn-primary">Add employee</a></div>}</section>

@if(ViewBag.DepartmentFilter != null){<a asp-action="Index" class="btn btn-outline-secondary">Show all departments</a>}

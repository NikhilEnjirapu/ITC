@model ITC.TrainingPortal.Application.DTOs.EmployeeDto
@{
    ViewData["Title"] = "Edit Employee";
}
<h2 class="fw-bold mb-4">Edit Employee</h2>

<div class="row">
    <div class="col-md-6">
        <div class="glass-panel p-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="RowVersion" />
                <div class="mb-3">
                    <label asp-for="EmployeeId" class="form-label">Employee ID</label>
                    <input asp-for="EmployeeId" class="form-control" />
                    <span asp-validation-for="EmployeeId" class="text-danger"></span>
                </div>
                <div class="mb-3"><label asp-for="WorkerType" class="form-label"></label><select asp-for="WorkerType" class="form-select">@foreach(var category in ITC.TrainingPortal.Application.Services.EligibilityEvaluator.WorkerTypes){<option value="@category">@category</option>}</select><span asp-validation-for="WorkerType" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="UserId" class="form-label"></label><input asp-for="UserId" class="form-control"/><div class="form-text">Corporate identity identifier used to match this employee to their sign-in account. Confirm it with your identity administrator.</div><span asp-validation-for="UserId" class="text-danger"></span></div>
<div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label">First Name</label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label">Last Name</label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" type="email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="DepartmentId" class="form-label">Department</label>
                    <select asp-for="DepartmentId" class="form-control" asp-items="ViewBag.Departments">
                        <option value="">-- Select Department --</option>
                    </select>
                    <span asp-validation-for="DepartmentId" class="text-danger"></span>
                </div>
                <div>
                    <button type="submit" class="btn btn-primary me-2">Save Changes</button>
                    <a asp-action="Index" class="btn btn-outline-light">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

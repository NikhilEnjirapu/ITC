{
  "PortalAuthorization": {
    "AllowDevelopmentBypass": false,
    "RoleClaimType": "roles",
    "AdministratorRole": "Administrator",
    "EmployeeRole": "Employee"
  },
  "EmployeeIdentity": {
    "MatchMode": "Email",
    "EmailClaimType": "preferred_username"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}

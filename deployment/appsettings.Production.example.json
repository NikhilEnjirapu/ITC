{
  "EntraId": {
    "Enabled": true,
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "REPLACE_WITH_TENANT_ID",
    "ClientId": "REPLACE_WITH_APP_REGISTRATION_ID",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  "PortalAuthorization": {
    "AllowDevelopmentBypass": false,
    "RoleClaimType": "roles",
    "AdministratorRole": "Administrator",
    "EmployeeRole": "Employee"
  },
  "EmployeeIdentity": {
    "MatchMode": "Email",
    "UserIdClaimType": "",
    "EmailClaimType": "preferred_username"
  },
  "VideoRepository": {
    "Path": "D:\\TrainingPortalData\\Videos"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=REPLACE_WITH_SQL_SERVER;Database=EmployeeTrainingPortal;Integrated Security=True;Encrypt=True;TrustServerCertificate=False"
  },
  "AllowedHosts": "REPLACE_WITH_PORTAL_HOST",
  "DataProtection": {
    "KeyPath": "D:\\TrainingPortalData\\Keys"
  }
}